# ==========================================
# TaskFlow Client Environment Configuration
# Copy this file to .env and configure your variables.
# ==========================================

# Backend API Base URL
VITE_API_URL=http://localhost:5000/api

# Google OAuth 2.0 Web Client ID (Publicly loaded in browser for Google Identity Services)
# Matches GOOGLE_CLIENT_ID on the backend
VITE_GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com

# Optional: Google Analytics 4 Measurement ID (e.g. G-XXXXXXXXXX)
# If left empty, TaskFlow will use its privacy-conscious first-party visitor analytics
VITE_GA_MEASUREMENT_ID=
